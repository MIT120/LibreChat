# LibreChat Web Search Environment Variables
# Copy these variables to your .env file and fill in your API keys

# ==============================================
# WEB SEARCH CONFIGURATION
# ==============================================

# Search Provider (Choose one)
# ---------------------------------------------
# Option 1: Serper (Recommended)
# Get your API key from: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Option 2: SearXNG (Alternative - self-hosted)
# SEARXNG_INSTANCE_URL=your_searxng_instance_url
# SEARXNG_API_KEY=your_searxng_api_key  # Optional if your instance requires auth

# Scraper Configuration (Required)
# ---------------------------------------------
# Firecrawl - Get your API key from: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: Custom Firecrawl instance URL
# FIRECRAWL_API_URL=your_custom_firecrawl_url

# Reranker Configuration (Choose one)
# ---------------------------------------------
# Option 1: Jina (Recommended)
# Get your API key from: https://jina.ai
JINA_API_KEY=your_jina_api_key_here

# Option 2: Cohere (Alternative)
# Get your API key from: https://dashboard.cohere.ai
# COHERE_API_KEY=your_cohere_api_key_here

# ==============================================
# INSTRUCTIONS
# ==============================================
#
# 1. Copy these variables to your .env file
# 2. Get API keys from the respective services:
#    - Serper: https://serper.dev (for web search)
#    - Firecrawl: https://firecrawl.dev (for web scraping)
#    - Jina: https://jina.ai (for reranking results)
#    - Alternative: Cohere: https://dashboard.cohere.ai
# 3. Remove the placeholder values and add your actual API keys
# 4. Restart your LibreChat instance to apply the changes
#
# Note: All three components (search provider, scraper, reranker) are required
# for effective web search results.
