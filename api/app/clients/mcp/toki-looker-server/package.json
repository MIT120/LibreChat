{
    "name": "toki-looker-server",
    "version": "1.0.0",
    "description": "MCP server for Toki Looker analytics and electricity statistics",
    "main": "dist/src/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "start": "node dist/src/index.js",
        "dev": "tsc && node --watch dist/src/index.js",
        "dev:ts": "tsc --watch & node --watch dist/src/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "mcp",
        "looker",
        "analytics",
        "electricity",
        "statistics",
        "toki"
    ],
    "dependencies": {
        "@modelcontextprotocol/sdk": "^0.6.0",
        "axios": "^1.6.0",
        "dotenv": "^16.0.0",
        "uuid": "^10.0.0",
        "zod": "^3.22.0",
        "zod-to-json-schema": "^3.24.6"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "@types/uuid": "^10.0.0",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.0",
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}