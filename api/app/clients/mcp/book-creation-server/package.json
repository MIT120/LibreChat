{
    "name": "book-creation-server",
    "version": "1.0.0",
    "description": "MCP server for book creation and management",
    "main": "dist/src/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "build:simple": "tsc src/index.ts --outDir dist --target ES2022 --module ESNext --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck",
        "start": "node dist/src/index.js",
        "start:simple": "node dist/src/simple-index.js",
        "dev": "tsc && node --watch dist/src/index.js",
        "dev:simple": "npm run build:simple && node --watch dist/src/simple-index.js",
        "dev:ts": "tsc --watch & node --watch dist/src/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit",
        "codex:test": "node scripts/test-codex.js",
        "codex:sync-all": "node scripts/sync-all-books.js",
        "codex:sync-all-auto": "node scripts/sync-all-books.js --auto",
        "codex:sync-book": "node scripts/sync-book.js",
        "codex:list-books": "node scripts/sync-book.js",
        "codex:help": "echo '📚 Codex Commands:\n  npm run codex:test - Test Codex functionality\n  npm run codex:sync-all - Sync all books (interactive)\n  npm run codex:sync-all-auto - Sync all books (automatic)\n  npm run codex:sync-book <bookId> - Sync specific book\n  npm run codex:list-books - List all available books'"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^0.6.0",
        "axios": "^1.6.0",
        "dotenv": "^16.0.0",
        "module-alias": "^2.2.3",
        "mongoose": "^8.0.0",
        "openai": "^4.0.0",
        "pdfkit": "^0.14.0",
        "sharp": "^0.32.0",
        "uuid": "^10.0.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "@types/uuid": "^10.0.0",
        "@types/pdfkit": "^0.12.0",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.0",
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}